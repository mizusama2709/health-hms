# Copy to .env.local and fill in. See README.md for what each variable does
# and which are required for which features.

DATABASE_URL="postgresql://user@localhost:5432/health_hms"
AUTH_SECRET="generate-with: npx auth secret"

# Inbound WhatsApp webhook signature verification
WHATSAPP_WEBHOOK_SECRET=""

# Outbound WhatsApp sending — omit WHATSAPP_PROVIDER (or set to anything
# other than "meta") to use the mock provider, which logs sends instead of
# delivering them. Only set the two below once you're ready to send real
# messages.
WHATSAPP_PROVIDER=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Scheduled-job auth (api/jobs/follow-up-reminders, api/jobs/audit-alerts)
CRON_SECRET=""

# S3-compatible object storage, for imaging (DICOM) files
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""
STORAGE_REGION=""
