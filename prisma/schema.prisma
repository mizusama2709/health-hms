generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN_RECEPTION
  SUPER_ADMIN
  NURSE
  RECEPTIONIST
  LAB
  PHARMACIST
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AppointmentStatus {
  BOOKED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  NEW
  FOLLOW_UP
}

enum AppointmentSource {
  MANUAL
  WHATSAPP
}

enum ServiceType {
  CONSULTATION
  LAB
  PHARMACY
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMode {
  CASH
  CARD
  UPI
  RAZORPAY
  OTHER
}

enum PaymentStatus {
  SUCCESS
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

enum JourneyStep {
  APPOINTMENT_BOOKED
  VITALS_TAKEN
  OPD_STARTED
  OPD_COMPLETED
  LAB_ORDERED
  LAB_COMPLETED
  MEDICINES_PRESCRIBED
  MEDICINES_DISPENSED
}

enum WhatsAppDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageStatus {
  RECEIVED
  PARSED
  PROCESSED
  FAILED
  SENT
  SIMULATED
}

enum LabOrderStatus {
  ORDERED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LabResultFlag {
  NORMAL
  ABNORMAL
  CRITICAL
}

enum PrescriptionStatus {
  PENDING
  DISPENSED
}

enum VitalsSource {
  IN_CLINIC
  WHATSAPP
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum QueueStage {
  REGISTRATION
  VITALS
  CONSULTATION
  LAB
  CONSULTATION_2
  PHARMACY
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("free")
  createdAt DateTime @default(now())

  users               User[]
  doctors             Doctor[]
  patients            Patient[]
  appointments        Appointment[]
  invoices            Invoice[]
  payments            Payment[]
  refunds             Refund[]
  journeyEvents       PatientJourneyEvent[]
  organizationProfile OrganizationProfile?
  hospitalSettings    HospitalSettings?
  departments         Department[]
  pharmacyReturns     PharmacyReturn[]
  knowledgeBaseDocs   KnowledgeBaseDocument[]
  whatsAppMessages    WhatsAppMessage[]
  services            Service[]
  labTestCatalogs     LabTestCatalog[]
  labOrders           LabOrder[]
  labReportTemplates  LabReportTemplate[]
  medicines           Medicine[]
  suppliers           Supplier[]
  goodsReceipts       GoodsReceipt[]
  prescriptions       Prescription[]
  rxTemplates         RxTemplate[]
  storeCredits        StoreCredit[]
  vitals              Vitals[]
  queueStageEntries   QueueStageEntry[]
  queueStageConfigs   QueueStageConfig[]
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  phone        String?
  role         Role
  status       UserStatus @default(ACTIVE)
  passwordHash String
  tenantId     String?
  tenant       Tenant?    @relation(fields: [tenantId], references: [id])
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  doctor  Doctor?
  patient Patient?

  assignedQueueStageEntries QueueStageEntry[]

  @@index([tenantId, role])
  @@index([tenantId, status])
}

model Doctor {
  id           String @id @default(cuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id])
  tenantId     String
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  specialty    String
  workingHours Json?

  appointments Appointment[]

  @@index([tenantId])
}

model Patient {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  dateOfBirth DateTime?
  gender      Gender?

  appointments  Appointment[]
  invoices      Invoice[]
  journeyEvents PatientJourneyEvent[]
  labOrders     LabOrder[]
  prescriptions Prescription[]
  storeCredits  StoreCredit[]
  vitals        Vitals[]

  @@index([tenantId])
}

model Appointment {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  doctorId    String
  doctor      Doctor            @relation(fields: [doctorId], references: [id])
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id])
  datetime    DateTime
  status      AppointmentStatus @default(BOOKED)
  type        AppointmentType   @default(NEW)
  serviceType ServiceType       @default(CONSULTATION)
  source      AppointmentSource @default(MANUAL)
  feeAmount   Decimal?
  paymentMode PaymentMode?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  visitRecord     VisitRecord?
  followUp        FollowUp?
  invoices        Invoice[]
  journeyEvents   PatientJourneyEvent[]
  whatsAppMessage WhatsAppMessage?
  labOrders       LabOrder[]
  prescriptions   Prescription[]
  vitals          Vitals[]
  queueStageEntries QueueStageEntry[]

  @@index([tenantId, datetime])
  @@index([tenantId, status])
  @@index([tenantId, doctorId, datetime])
  @@index([tenantId, source])
}

model FollowUp {
  id                String      @id @default(cuid())
  appointmentId     String      @unique
  appointment       Appointment @relation(fields: [appointmentId], references: [id])
  dueDate           DateTime
  status            String      @default("pending")
  reminderScheduled Boolean     @default(false)
  reminderAt        DateTime?
  reminderMessage   String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model VisitRecord {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  notes         String
  diagnosis     String?
  prescription  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  prescriptions Prescription[]
}

model Invoice {
  id             String            @id @default(cuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id])
  appointmentId  String?
  appointment    Appointment?      @relation(fields: [appointmentId], references: [id])
  invoiceNumber  String            @unique
  serviceType    ServiceType
  source         AppointmentSource @default(MANUAL)
  subtotal       Decimal
  discountAmount Decimal           @default(0)
  cgstAmount     Decimal           @default(0)
  sgstAmount     Decimal           @default(0)
  totalAmount    Decimal
  amountPaid     Decimal           @default(0)
  status         InvoiceStatus     @default(UNPAID)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  lineItems InvoiceLineItem[]
  payments  Payment[]
  refunds   Refund[]

  @@index([tenantId, status])
  @@index([tenantId, serviceType])
  @@index([tenantId, createdAt])
  @@index([tenantId, source])
}

model InvoiceLineItem {
  id             String      @id @default(cuid())
  invoiceId      String
  invoice        Invoice     @relation(fields: [invoiceId], references: [id])
  serviceId      String?
  service        Service?    @relation(fields: [serviceId], references: [id])
  description    String
  serviceType    ServiceType
  quantity       Int         @default(1)
  unitPrice      Decimal
  discountAmount Decimal     @default(0)
  taxRatePercent Decimal     @default(0)
  lineTotal      Decimal
  createdAt      DateTime    @default(now())

  pharmacyReturns PharmacyReturn[]

  @@index([invoiceId])
  @@index([serviceId])
}

model Service {
  id               String      @id @default(cuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  name             String
  serviceType      ServiceType
  defaultUnitPrice Decimal
  taxRatePercent   Decimal     @default(0)
  description      String?
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  lineItems InvoiceLineItem[]

  @@index([tenantId, serviceType])
  @@index([tenantId, isActive])
}

model Payment {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  amount       Decimal
  mode         PaymentMode
  status       PaymentStatus @default(SUCCESS)
  reference    String?
  paidAt       DateTime      @default(now())
  recordedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  refunds Refund[]

  @@index([tenantId, paidAt])
  @@index([tenantId, status])
  @@index([invoiceId])
}

model Refund {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id])
  paymentId    String?
  payment      Payment? @relation(fields: [paymentId], references: [id])
  amount       Decimal
  reason       String?
  refundedAt   DateTime @default(now())
  recordedById String?
  createdAt    DateTime @default(now())

  @@index([tenantId, refundedAt])
  @@index([invoiceId])
}

model PatientJourneyEvent {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id])
  step          JourneyStep
  occurredAt    DateTime    @default(now())
  recordedById  String?
  createdAt     DateTime    @default(now())

  @@index([tenantId, appointmentId, step])
  @@index([tenantId, patientId, occurredAt])
}

model Vitals {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  bp            String?
  glucose       Decimal?
  weight        Decimal?
  spo2          Int?
  source        VitalsSource @default(IN_CLINIC)
  recordedById  String?
  recordedAt    DateTime     @default(now())
  createdAt     DateTime     @default(now())

  @@index([tenantId, patientId, recordedAt])
  @@index([appointmentId])
}

model QueueStageEntry {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  stage         QueueStage
  assignedToId  String?
  assignedTo    User?       @relation(fields: [assignedToId], references: [id])
  remark        String?
  startedAt     DateTime    @default(now())
  completedAt   DateTime?
  createdAt     DateTime    @default(now())

  @@unique([appointmentId, stage])
  @@index([tenantId, appointmentId])
}

model QueueStageConfig {
  id                String     @id @default(cuid())
  tenantId          String
  tenant            Tenant     @relation(fields: [tenantId], references: [id])
  stage             QueueStage
  turnaroundMinutes Int        @default(15)

  @@unique([tenantId, stage])
}

model OrganizationProfile {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  legalName      String?
  gstNumber      String?
  companySize    String?
  hqAddressLine1 String?
  hqAddressLine2 String?
  hqCity         String?
  hqState        String?
  hqPostalCode   String?
  hqCountry      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HospitalSettings {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  registrationNumber String?
  addressLine1       String?
  addressLine2        String?
  city                String?
  state               String?
  postalCode          String?
  defaultWorkingHours Json?

  bookingLeadTimeMinutes    Int?
  cancellationWindowMinutes Int?
  bookingPolicyNotes        String?

  pharmacyGstNumber String?

  paymentQrImageUrl   String?
  paymentUpiId        String?
  paymentPayeeName    String?
  razorpayPaymentLink String?
  labUpiId            String?
  pharmacyUpiId       String?

  invoiceHeaderLogoUrl    String?
  invoiceHeaderText       String?
  pharmacyInvoiceTemplate String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]
}

model Department {
  id                 String           @id @default(cuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  hospitalSettingsId String
  hospitalSettings   HospitalSettings @relation(fields: [hospitalSettingsId], references: [id])
  name               String
  createdAt          DateTime         @default(now())

  @@index([tenantId])
}

model PharmacyReturn {
  id                String          @id @default(cuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  invoiceLineItemId String
  invoiceLineItem   InvoiceLineItem @relation(fields: [invoiceLineItemId], references: [id])
  invoiceId         String
  quantityReturned  Int
  refundAmount      Decimal?
  reason            String?
  recordedById      String?
  returnedAt        DateTime        @default(now())
  createdAt         DateTime        @default(now())

  storeCredit StoreCredit?

  @@index([tenantId, returnedAt])
  @@index([invoiceId])
}

model Prescription {
  id            String             @id @default(cuid())
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  visitRecordId String?
  visitRecord   VisitRecord?       @relation(fields: [visitRecordId], references: [id])
  appointmentId String?
  appointment   Appointment?       @relation(fields: [appointmentId], references: [id])
  patientId     String
  patient       Patient            @relation(fields: [patientId], references: [id])
  status        PrescriptionStatus @default(PENDING)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  items PrescriptionItem[]

  @@index([tenantId, status])
  @@index([tenantId, patientId])
}

model PrescriptionItem {
  id                 String       @id @default(cuid())
  prescriptionId     String
  prescription       Prescription @relation(fields: [prescriptionId], references: [id])
  medicineId         String
  medicine           Medicine     @relation(fields: [medicineId], references: [id])
  quantity           Int
  dosageInstructions String?

  @@index([prescriptionId])
}

model StoreCredit {
  id                      String          @id @default(cuid())
  tenantId                String
  tenant                  Tenant          @relation(fields: [tenantId], references: [id])
  patientId               String
  patient                 Patient         @relation(fields: [patientId], references: [id])
  amount                  Decimal
  reason                  String?
  relatedPharmacyReturnId String?         @unique
  relatedPharmacyReturn   PharmacyReturn? @relation(fields: [relatedPharmacyReturnId], references: [id])
  createdAt               DateTime        @default(now())

  @@index([tenantId, patientId])
}

model KnowledgeBaseDocument {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  title        String
  fileUrl      String
  fileType     String?
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([tenantId])
}

model WhatsAppMessage {
  id                   String                @id @default(cuid())
  tenantId             String
  tenant               Tenant                @relation(fields: [tenantId], references: [id])
  direction            WhatsAppDirection
  status               WhatsAppMessageStatus @default(RECEIVED)
  fromPhone            String?
  toPhone              String?
  rawPayload           Json
  parsedIntent         String?
  relatedAppointmentId String?               @unique
  relatedAppointment   Appointment?          @relation(fields: [relatedAppointmentId], references: [id])
  relatedInvoiceId     String?
  errorMessage         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([tenantId, direction, status])
  @@index([tenantId, createdAt])
}

model LabTestCatalog {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  name           String
  code           String?
  defaultPrice   Decimal
  turnaroundTime String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  orderItems LabOrderItem[]

  @@index([tenantId])
}

model LabOrder {
  id            String         @id @default(cuid())
  tenantId      String
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  patientId     String
  patient       Patient        @relation(fields: [patientId], references: [id])
  appointmentId String?
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  orderedById   String
  status        LabOrderStatus @default(ORDERED)
  orderedAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  items   LabOrderItem[]
  reports LabReport[]

  @@index([tenantId, status])
  @@index([tenantId, patientId])
}

model LabOrderItem {
  id             String          @id @default(cuid())
  labOrderId     String
  labOrder       LabOrder        @relation(fields: [labOrderId], references: [id])
  labTestId      String
  labTest        LabTestCatalog  @relation(fields: [labTestId], references: [id])
  resultValue    String?
  resultUnit     String?
  referenceRange String?
  flag           LabResultFlag?
  createdAt      DateTime        @default(now())

  @@index([labOrderId])
}

model LabReport {
  id           String   @id @default(cuid())
  labOrderId   String
  labOrder     LabOrder @relation(fields: [labOrderId], references: [id])
  fileUrl      String
  uploadedById String
  uploadedAt   DateTime @default(now())

  @@index([labOrderId])
}

model LabReportTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Medicine {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  sku           String?
  unitPrice     Decimal
  stockQuantity Int      @default(0)
  reorderLevel  Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  goodsReceiptItems GoodsReceiptLineItem[]
  prescriptionItems PrescriptionItem[]
  rxTemplateItems   RxTemplateItem[]

  @@index([tenantId])
  @@index([tenantId, stockQuantity])
}

model Supplier {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  contactPhone String?
  contactEmail String?
  createdAt    DateTime @default(now())

  goodsReceipts GoodsReceipt[]

  @@index([tenantId])
}

model GoodsReceipt {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  receivedById String
  receivedAt   DateTime @default(now())
  notes        String?

  lineItems GoodsReceiptLineItem[]

  @@index([tenantId, receivedAt])
}

model GoodsReceiptLineItem {
  id               String       @id @default(cuid())
  goodsReceiptId   String
  goodsReceipt     GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
  medicineId       String
  medicine         Medicine     @relation(fields: [medicineId], references: [id])
  quantityReceived Int
  unitCost         Decimal

  @@index([goodsReceiptId])
}

model RxTemplate {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  name       String
  diseaseTag String
  createdAt  DateTime @default(now())

  items RxTemplateItem[]

  @@index([tenantId])
}

model RxTemplateItem {
  id                 String     @id @default(cuid())
  rxTemplateId       String
  rxTemplate         RxTemplate @relation(fields: [rxTemplateId], references: [id])
  medicineId         String
  medicine           Medicine   @relation(fields: [medicineId], references: [id])
  quantity           Int
  dosageInstructions String?

  @@index([rxTemplateId])
}
