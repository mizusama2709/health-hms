generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN_RECEPTION
  SUPER_ADMIN
  NURSE
  RECEPTIONIST
  LAB
  PHARMACIST
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AppointmentStatus {
  BOOKED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum CancelledBy {
  PATIENT
  DOCTOR
  STAFF
}

enum AppointmentType {
  NEW
  FOLLOW_UP
}

enum AppointmentSource {
  MANUAL
  WHATSAPP
}

enum ServiceType {
  CONSULTATION
  LAB
  PHARMACY
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMode {
  CASH
  CARD
  UPI
  RAZORPAY
  OTHER
}

enum PaymentStatus {
  SUCCESS
  REFUNDED
  PARTIALLY_REFUNDED
  FAILED
}

enum JourneyStep {
  APPOINTMENT_BOOKED
  VITALS_TAKEN
  OPD_STARTED
  OPD_COMPLETED
  LAB_ORDERED
  LAB_COMPLETED
  MEDICINES_PRESCRIBED
  MEDICINES_DISPENSED
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  ESCALATED
  CANCELLED
}

enum FollowUpOutcome {
  IMPROVING
  NO_CHANGE
  WORSENING
  ADVERSE_REACTION
  RESOLVED
  UNREACHABLE
}

enum FollowUpNextAction {
  NONE
  ANOTHER_CALL_SCHEDULED
  BOOK_APPOINTMENT
  ESCALATE_TO_DOCTOR
}

enum WhatsAppDirection {
  INBOUND
  OUTBOUND
}

enum WhatsAppMessageStatus {
  RECEIVED
  PARSED
  PROCESSED
  FAILED
  SENT
  SIMULATED
  DELIVERED
  READ
}

enum LabOrderStatus {
  ORDERED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LabResultFlag {
  NORMAL
  ABNORMAL
  CRITICAL
}

enum PrescriptionStatus {
  PENDING
  DISPENSED
}

enum DoseTime {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

enum DurationUnit {
  DAYS
  WEEKS
  MONTHS
}

enum VitalsSource {
  IN_CLINIC
  WHATSAPP
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum LeadStatus {
  ENQUIRY
  SYMPTOMS_COLLECTED
  DOCTOR_RECOMMENDED
  PAYMENT_PENDING
  PAYMENT_COLLECTED
  APPOINTMENT_BOOKED
  FOLLOW_UP
  CONVERTED
}

enum LeadSource {
  MANUAL
  WHATSAPP
  IMPORT
}

enum QueueStage {
  REGISTRATION
  VITALS
  CONSULTATION
  LAB
  CONSULTATION_2
  PHARMACY
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      String   @default("free")
  createdAt DateTime @default(now())

  users               User[]
  doctors             Doctor[]
  patients            Patient[]
  leads               Lead[]
  appointments        Appointment[]
  invoices            Invoice[]
  payments            Payment[]
  refunds             Refund[]
  journeyEvents       PatientJourneyEvent[]
  organizationProfile OrganizationProfile?
  hospitalSettings    HospitalSettings?
  departments         Department[]
  pharmacyReturns     PharmacyReturn[]
  knowledgeBaseDocs   KnowledgeBaseDocument[]
  whatsAppMessages    WhatsAppMessage[]
  services            Service[]
  labTestCatalogs     LabTestCatalog[]
  labOrders           LabOrder[]
  labReportTemplates  LabReportTemplate[]
  medicines           Medicine[]
  medicineBatches     MedicineBatch[]
  invoiceCounter      InvoiceCounter?
  suppliers           Supplier[]
  goodsReceipts       GoodsReceipt[]
  prescriptions       Prescription[]
  rxTemplates         RxTemplate[]
  storeCredits        StoreCredit[]
  vitals              Vitals[]
  queueStageEntries   QueueStageEntry[]
  queueStageConfigs   QueueStageConfig[]
  followUps           FollowUp[]
  followUpCallLogs    FollowUpCallLog[]
  imagingOrders       ImagingOrder[]
}

// Append-only, deliberately not per-tenant (login happens before a tenant
// is known) — a shared, multi-instance-safe replacement for the in-memory
// Map loginRateLimit.ts used to use, which reset on every deploy/restart
// and wasn't shared across server instances. Old rows are harmless (the
// rate-limit query filters by window) but accumulate for accounts that
// are only ever attacked and never log in successfully — a periodic
// prune is a reasonable follow-up, not required for correctness.
model LoginAttempt {
  id          String   @id @default(cuid())
  email       String
  attemptedAt DateTime @default(now())

  @@index([email, attemptedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  userEmail  String?
  action     String // e.g. "PATIENT_VIEW", "VISIT_RECORD_WRITE", "PRESCRIPTION_CREATE"
  entityType String
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())
  // Set once the audit-alerts job has surfaced this row as a Notification —
  // same dedupe pattern as FollowUp.reminderSentAt, so a discrete
  // alert-worthy event (e.g. a SUPER_ADMIN grant) is never re-notified.
  alertedAt  DateTime?

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([action, alertedAt])
}

// userId null = tenant-wide broadcast (visible to everyone in the tenant);
// set = targeted at one user. A single model covers both without needing
// per-role fan-out at write time — visibility is just "mine or nobody's".
model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String?
  type      String // e.g. "APPOINTMENT_BOOKED", "APPOINTMENT_CANCELLED", "LAB_RESULT_CRITICAL"
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId, createdAt])
  @@index([tenantId, readAt])
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  phone        String?
  role         Role
  status       UserStatus @default(ACTIVE)
  passwordHash String
  tenantId     String?
  tenant       Tenant?    @relation(fields: [tenantId], references: [id])
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  doctor  Doctor?
  patient Patient?

  assignedQueueStageEntries QueueStageEntry[]

  @@index([tenantId, role])
  @@index([tenantId, status])
}

model Doctor {
  id           String @id @default(cuid())
  userId       String @unique
  user         User   @relation(fields: [userId], references: [id])
  tenantId     String
  tenant       Tenant @relation(fields: [tenantId], references: [id])
  specialty    String
  workingHours Json?

  appointments Appointment[]

  @@index([tenantId])
}

model Patient {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  dateOfBirth DateTime?
  gender      Gender?

  appointments  Appointment[]
  invoices      Invoice[]
  journeyEvents PatientJourneyEvent[]
  labOrders     LabOrder[]
  prescriptions Prescription[]
  storeCredits  StoreCredit[]
  vitals        Vitals[]
  imagingOrders ImagingOrder[]

  @@index([tenantId])
}

model Lead {
  id                 String     @id @default(cuid())
  tenantId           String
  tenant             Tenant     @relation(fields: [tenantId], references: [id])
  name               String
  phone              String
  email              String?
  status             LeadStatus @default(ENQUIRY)
  source             LeadSource @default(MANUAL)
  notes              String?
  convertedPatientId String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([tenantId, status])
}

model Appointment {
  id          String            @id @default(cuid())
  tenantId    String
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  doctorId    String
  doctor      Doctor            @relation(fields: [doctorId], references: [id])
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id])
  datetime    DateTime
  status      AppointmentStatus @default(BOOKED)
  cancelledBy CancelledBy?
  type        AppointmentType   @default(NEW)
  serviceType ServiceType       @default(CONSULTATION)
  source      AppointmentSource @default(MANUAL)
  feeAmount   Decimal?
  paymentMode PaymentMode?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  visitRecord       VisitRecord?
  followUp          FollowUp?
  invoices          Invoice[]
  journeyEvents     PatientJourneyEvent[]
  whatsAppMessage   WhatsAppMessage?
  labOrders         LabOrder[]
  prescriptions     Prescription[]
  vitals            Vitals[]
  queueStageEntries QueueStageEntry[]
  imagingOrders     ImagingOrder[]

  @@index([tenantId, datetime])
  @@index([tenantId, status])
  @@index([tenantId, doctorId, datetime])
  @@index([tenantId, source])
}

model FollowUp {
  id                String         @id @default(cuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  appointmentId     String         @unique
  appointment       Appointment    @relation(fields: [appointmentId], references: [id])
  focusInstructions String
  prescribedById    String?
  dueDate           DateTime
  status            FollowUpStatus @default(PENDING)
  reminderScheduled Boolean        @default(false)
  reminderAt        DateTime?
  reminderMessage   String?
  // Set once the reminder job has dispatched (or terminally failed to
  // dispatch, e.g. no phone on file) — distinct from reminderScheduled,
  // which only records staff intent. Null + reminderScheduled + due
  // reminderAt is exactly the job's "still needs sending" query.
  reminderSentAt    DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  callLogs        FollowUpCallLog[]
  linkedLabOrders LabOrder[]

  @@index([tenantId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, reminderScheduled, reminderSentAt, reminderAt])
}

model FollowUpCallLog {
  id             String             @id @default(cuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  followUpId     String
  followUp       FollowUp           @relation(fields: [followUpId], references: [id])
  calledById     String
  calledAt       DateTime           @default(now())
  outcome        FollowUpOutcome
  notes          String
  nextAction     FollowUpNextAction @default(NONE)
  nextFollowUpAt DateTime?
  createdAt      DateTime           @default(now())

  @@index([tenantId, outcome])
  @@index([tenantId, calledAt])
}

model VisitRecord {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  notes         String
  diagnosis     String?
  prescription  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  prescriptions Prescription[]
}

model InvoiceCounter {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  value    Int    @default(0)
}

model Invoice {
  id             String            @id @default(cuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id])
  appointmentId  String?
  appointment    Appointment?      @relation(fields: [appointmentId], references: [id])
  invoiceNumber  String            @unique
  serviceType    ServiceType
  source         AppointmentSource @default(MANUAL)
  subtotal       Decimal
  discountAmount Decimal           @default(0)
  cgstAmount     Decimal           @default(0)
  sgstAmount     Decimal           @default(0)
  totalAmount    Decimal
  amountPaid     Decimal           @default(0)
  status         InvoiceStatus     @default(UNPAID)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  lineItems InvoiceLineItem[]
  payments  Payment[]
  refunds   Refund[]

  @@index([tenantId, status])
  @@index([tenantId, serviceType])
  @@index([tenantId, createdAt])
  @@index([tenantId, source])
}

model InvoiceLineItem {
  id             String      @id @default(cuid())
  invoiceId      String
  invoice        Invoice     @relation(fields: [invoiceId], references: [id])
  serviceId      String?
  service        Service?    @relation(fields: [serviceId], references: [id])
  description    String
  serviceType    ServiceType
  quantity       Int         @default(1)
  unitPrice      Decimal
  discountAmount Decimal     @default(0)
  taxRatePercent Decimal     @default(0)
  lineTotal      Decimal
  createdAt      DateTime    @default(now())

  pharmacyReturns PharmacyReturn[]

  @@index([invoiceId])
  @@index([serviceId])
}

model Service {
  id               String      @id @default(cuid())
  tenantId         String
  tenant           Tenant      @relation(fields: [tenantId], references: [id])
  name             String
  serviceType      ServiceType
  defaultUnitPrice Decimal
  taxRatePercent   Decimal     @default(0)
  description      String?
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  lineItems InvoiceLineItem[]

  @@index([tenantId, serviceType])
  @@index([tenantId, isActive])
}

model Payment {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  invoiceId    String
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  amount       Decimal
  mode         PaymentMode
  status       PaymentStatus @default(SUCCESS)
  reference    String?
  paidAt       DateTime      @default(now())
  recordedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  refunds Refund[]

  @@index([tenantId, paidAt])
  @@index([tenantId, status])
  @@index([invoiceId])
}

model Refund {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id])
  paymentId    String?
  payment      Payment? @relation(fields: [paymentId], references: [id])
  amount       Decimal
  reason       String?
  refundedAt   DateTime @default(now())
  recordedById String?
  createdAt    DateTime @default(now())

  @@index([tenantId, refundedAt])
  @@index([invoiceId])
}

model PatientJourneyEvent {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  patientId     String
  patient       Patient     @relation(fields: [patientId], references: [id])
  step          JourneyStep
  occurredAt    DateTime    @default(now())
  recordedById  String?
  createdAt     DateTime    @default(now())

  @@index([tenantId, appointmentId, step])
  @@index([tenantId, patientId, occurredAt])
}

model Vitals {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  patientId     String
  patient       Patient      @relation(fields: [patientId], references: [id])
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  bp            String?
  glucose       Decimal?
  weight        Decimal?
  spo2          Int?
  source        VitalsSource @default(IN_CLINIC)
  recordedById  String?
  recordedAt    DateTime     @default(now())
  createdAt     DateTime     @default(now())

  @@index([tenantId, patientId, recordedAt])
  @@index([appointmentId])
}

model QueueStageEntry {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  stage         QueueStage
  assignedToId  String?
  assignedTo    User?       @relation(fields: [assignedToId], references: [id])
  remark        String?
  startedAt     DateTime    @default(now())
  completedAt   DateTime?
  createdAt     DateTime    @default(now())

  @@unique([appointmentId, stage])
  @@index([tenantId, appointmentId])
}

model QueueStageConfig {
  id                String     @id @default(cuid())
  tenantId          String
  tenant            Tenant     @relation(fields: [tenantId], references: [id])
  stage             QueueStage
  turnaroundMinutes Int        @default(15)

  @@unique([tenantId, stage])
}

model OrganizationProfile {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  legalName      String?
  gstNumber      String?
  companySize    String?
  hqAddressLine1 String?
  hqAddressLine2 String?
  hqCity         String?
  hqState        String?
  hqPostalCode   String?
  hqCountry      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model HospitalSettings {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  registrationNumber  String?
  addressLine1        String?
  addressLine2        String?
  city                String?
  state               String?
  postalCode          String?
  defaultWorkingHours Json?

  bookingLeadTimeMinutes    Int?
  cancellationWindowMinutes Int?
  bookingPolicyNotes        String?

  pharmacyGstNumber String?

  paymentQrImageUrl   String?
  paymentUpiId        String?
  paymentPayeeName    String?
  razorpayPaymentLink String?
  labUpiId            String?
  pharmacyUpiId       String?

  invoiceHeaderLogoUrl    String?
  invoiceHeaderText       String?
  pharmacyInvoiceTemplate String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]
}

model Department {
  id                 String           @id @default(cuid())
  tenantId           String
  tenant             Tenant           @relation(fields: [tenantId], references: [id])
  hospitalSettingsId String
  hospitalSettings   HospitalSettings @relation(fields: [hospitalSettingsId], references: [id])
  name               String
  createdAt          DateTime         @default(now())

  @@index([tenantId])
}

model PharmacyReturn {
  id                String          @id @default(cuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  invoiceLineItemId String
  invoiceLineItem   InvoiceLineItem @relation(fields: [invoiceLineItemId], references: [id])
  invoiceId         String
  quantityReturned  Int
  refundAmount      Decimal?
  reason            String?
  recordedById      String?
  returnedAt        DateTime        @default(now())
  createdAt         DateTime        @default(now())

  storeCredit StoreCredit?

  @@index([tenantId, returnedAt])
  @@index([invoiceId])
}

model Prescription {
  id            String             @id @default(cuid())
  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  visitRecordId String?
  visitRecord   VisitRecord?       @relation(fields: [visitRecordId], references: [id])
  appointmentId String?
  appointment   Appointment?       @relation(fields: [appointmentId], references: [id])
  patientId     String
  patient       Patient            @relation(fields: [patientId], references: [id])
  status        PrescriptionStatus @default(PENDING)
  invoiceId     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  items PrescriptionItem[]

  @@index([tenantId, status])
  @@index([tenantId, patientId])
}

model PrescriptionItem {
  id                 String        @id @default(cuid())
  prescriptionId     String
  prescription       Prescription  @relation(fields: [prescriptionId], references: [id])
  medicineId         String
  medicine           Medicine      @relation(fields: [medicineId], references: [id])
  quantity           Int
  doseTimes          DoseTime[]
  durationValue      Int?
  durationUnit       DurationUnit?
  dosageInstructions String?

  @@index([prescriptionId])
}

model StoreCredit {
  id                      String          @id @default(cuid())
  tenantId                String
  tenant                  Tenant          @relation(fields: [tenantId], references: [id])
  patientId               String
  patient                 Patient         @relation(fields: [patientId], references: [id])
  amount                  Decimal
  reason                  String?
  relatedPharmacyReturnId String?         @unique
  relatedPharmacyReturn   PharmacyReturn? @relation(fields: [relatedPharmacyReturnId], references: [id])
  createdAt               DateTime        @default(now())

  @@index([tenantId, patientId])
}

model KnowledgeBaseDocument {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  title        String
  fileUrl      String
  fileType     String?
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([tenantId])
}

model WhatsAppMessage {
  id                    String                @id @default(cuid())
  tenantId              String
  tenant                Tenant                @relation(fields: [tenantId], references: [id])
  direction             WhatsAppDirection
  status                WhatsAppMessageStatus @default(RECEIVED)
  fromPhone             String?
  toPhone               String?
  rawPayload            Json
  parsedIntent          String?
  relatedAppointmentId  String?               @unique
  relatedAppointment    Appointment?          @relation(fields: [relatedAppointmentId], references: [id])
  relatedInvoiceId      String?
  relatedLabReportId    String?
  relatedPrescriptionId String?
  relatedFollowUpId     String?
  relatedVisitRecordId  String?
  // The provider's own message id (Meta's "wamid...") — nothing internal
  // ever generates or looks this up except the delivery-status webhook,
  // which has no other way to say "this is the message you sent a minute
  // ago" than the id the provider itself returned at send time.
  providerMessageId     String?               @unique
  errorMessage          String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([tenantId, direction, status])
  @@index([tenantId, createdAt])
}

model LabTestCatalog {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  name           String
  code           String?
  sampleType     String?
  defaultPrice   Decimal
  gstPercent     Decimal  @default(0)
  turnaroundTime String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  orderItems LabOrderItem[]
  parameters LabTestParameter[]

  @@index([tenantId])
}

// A single reference-range row for a lab test (e.g. "Hemoglobin, g/dL,
// 13-17"); a test can have several (per-parameter panels) or none (simple
// tests report a single value with no separate parameter breakdown).
model LabTestParameter {
  id            String         @id @default(cuid())
  labTestId     String
  labTest       LabTestCatalog @relation(fields: [labTestId], references: [id])
  name          String
  unit          String?
  referenceLow  Decimal?
  referenceHigh Decimal?
  referenceText String? // for non-numeric ranges, e.g. "Non-reactive", "Negative"
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())

  @@index([labTestId])
}

model LabOrder {
  id                 String         @id @default(cuid())
  tenantId           String
  tenant             Tenant         @relation(fields: [tenantId], references: [id])
  patientId          String
  patient            Patient        @relation(fields: [patientId], references: [id])
  appointmentId      String?
  appointment        Appointment?   @relation(fields: [appointmentId], references: [id])
  followUpId         String?
  followUp           FollowUp?      @relation(fields: [followUpId], references: [id])
  orderedById        String
  status             LabOrderStatus @default(ORDERED)
  orderedAt          DateTime       @default(now())
  patientConsentedAt DateTime
  approvedById       String?
  approvedAt         DateTime?
  updatedAt          DateTime       @updatedAt

  items   LabOrderItem[]
  reports LabReport[]

  @@index([tenantId, status])
  @@index([tenantId, patientId])
  @@index([followUpId])
}

model LabOrderItem {
  id             String         @id @default(cuid())
  labOrderId     String
  labOrder       LabOrder       @relation(fields: [labOrderId], references: [id])
  labTestId      String
  labTest        LabTestCatalog @relation(fields: [labTestId], references: [id])
  resultValue    String?
  resultUnit     String?
  referenceRange String?
  flag           LabResultFlag?
  // True once staff has deliberately chosen a flag (vs. it being computed by
  // recordLabResult's auto-flagging) — without this, a previously-computed
  // flag round-trips back through the form on the next save and looks like
  // a deliberate choice, silently freezing it out of date.
  flagIsManual   Boolean        @default(false)
  createdAt      DateTime       @default(now())

  @@index([labOrderId])
}

model LabReport {
  id           String   @id @default(cuid())
  labOrderId   String
  labOrder     LabOrder @relation(fields: [labOrderId], references: [id])
  fileUrl      String
  pdfData      Bytes? // null for the one legacy manually-pasted-URL report that predates auto-generation
  uploadedById String
  uploadedAt   DateTime @default(now())

  @@index([labOrderId])
}

enum ImagingModality {
  XRAY
  CT
  MRI
  ULTRASOUND
}

enum ImagingOrderStatus {
  ORDERED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ImagingOrder {
  id                 String             @id @default(cuid())
  tenantId           String
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  patientId          String
  patient            Patient            @relation(fields: [patientId], references: [id])
  appointmentId      String?
  appointment        Appointment?       @relation(fields: [appointmentId], references: [id])
  orderedById        String
  modality           ImagingModality
  description        String?
  status             ImagingOrderStatus @default(ORDERED)
  orderedAt          DateTime           @default(now())
  patientConsentedAt DateTime
  approvedById       String?
  approvedAt         DateTime?

  studies ImagingStudy[]

  @@index([tenantId, status])
  @@index([tenantId, patientId])
}

model ImagingStudy {
  id               String       @id @default(cuid())
  imagingOrderId   String
  imagingOrder     ImagingOrder @relation(fields: [imagingOrderId], references: [id])
  studyInstanceUid String?
  uploadedById     String
  uploadedAt       DateTime     @default(now())

  series ImagingSeries[]

  @@index([imagingOrderId])
}

model ImagingSeries {
  id                      String       @id @default(cuid())
  studyId                 String
  study                   ImagingStudy @relation(fields: [studyId], references: [id])
  seriesInstanceUid       String
  seriesNumber            Int?
  sliceThickness          Float?
  pixelSpacingX           Float?
  pixelSpacingY           Float?
  imageOrientationPatient String? // comma-separated direction cosines, from the DICOM header

  instances ImagingInstance[]

  @@unique([studyId, seriesInstanceUid])
}

model ImagingInstance {
  id             String        @id @default(cuid())
  seriesId       String
  series         ImagingSeries @relation(fields: [seriesId], references: [id])
  sopInstanceUid String        @unique // generated for non-DICOM files, which have no real SOPInstanceUID
  instanceNumber Int
  contentType    String        @default("application/dicom") // application/dicom | image/jpeg | image/png | application/pdf
  storageKey     String // S3/R2 object key — never bytes-in-Postgres, unlike LabReport
  fileSize       Int
  createdAt      DateTime      @default(now())

  @@index([seriesId])
}

model LabReportTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// Covers the three patient-facing PDF types that don't have their own
// dedicated table the way LabReport does (invoice, prescription,
// consultation summary). One row per generation rather than updating in
// place — a document is regenerated fresh every time it's sent (an
// invoice's amountPaid/status can change between sends), so each send's
// download link points at an immutable point-in-time snapshot instead of
// live data that could drift after the link was already texted out.
model GeneratedDocument {
  id             String   @id @default(cuid())
  tenantId       String
  type           String // "invoice" | "prescription" | "consultation_summary"
  invoiceId      String?
  prescriptionId String?
  visitRecordId  String?
  fileUrl        String
  pdfData        Bytes
  generatedAt    DateTime @default(now())

  @@index([tenantId, type])
  @@index([type, invoiceId])
  @@index([type, prescriptionId])
  @@index([type, visitRecordId])
}

model Medicine {
  id            String   @id @default(cuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  name          String
  sku           String?
  unitPrice     Decimal
  stockQuantity Int      @default(0)
  reorderLevel  Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  goodsReceiptItems GoodsReceiptLineItem[]
  prescriptionItems PrescriptionItem[]
  rxTemplateItems   RxTemplateItem[]
  batches           MedicineBatch[]

  @@index([tenantId])
  @@index([tenantId, stockQuantity])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model MedicineBatch {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  medicineId   String
  medicine     Medicine  @relation(fields: [medicineId], references: [id])
  batchNo      String?
  manufacturer String?
  genericName  String?
  receivedDate DateTime?
  expiryDate   DateTime?
  openingStock Int       @default(0)
  billedQty    Int       @default(0)
  availableQty Int       @default(0)
  packSize     String?
  createdAt    DateTime  @default(now())

  @@index([tenantId, medicineId])
  @@index([tenantId, expiryDate])
}

model Supplier {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  contactPhone String?
  contactEmail String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  goodsReceipts GoodsReceipt[]

  @@index([tenantId])
}

model GoodsReceipt {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  receivedById String
  receivedAt   DateTime @default(now())
  notes        String?

  lineItems GoodsReceiptLineItem[]

  @@index([tenantId, receivedAt])
}

model GoodsReceiptLineItem {
  id               String       @id @default(cuid())
  goodsReceiptId   String
  goodsReceipt     GoodsReceipt @relation(fields: [goodsReceiptId], references: [id])
  medicineId       String
  medicine         Medicine     @relation(fields: [medicineId], references: [id])
  quantityReceived Int
  unitCost         Decimal

  @@index([goodsReceiptId])
}

model RxTemplate {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  name       String
  diseaseTag String
  createdAt  DateTime @default(now())

  items RxTemplateItem[]

  @@index([tenantId])
}

model RxTemplateItem {
  id                 String     @id @default(cuid())
  rxTemplateId       String
  rxTemplate         RxTemplate @relation(fields: [rxTemplateId], references: [id])
  medicineId         String
  medicine           Medicine   @relation(fields: [medicineId], references: [id])
  quantity           Int
  dosageInstructions String?

  @@index([rxTemplateId])
}
